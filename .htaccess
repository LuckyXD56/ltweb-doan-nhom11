# KhÃ´ng liá»‡t kÃª ná»™i dung thÆ° má»¥c
Options -Indexes

# Tá»‡p, thÆ° má»¥c áº©n (.env, .gitâ€¦) â€” chá»«a .well-known
RedirectMatch 404 /\.(?!well-known/)

# ThÆ° má»¥c ná»™i bá»™ cá»§a dá»± Ã¡n
RedirectMatch 404 /(inc|src|vendor|database|logs|storage)(/|$)

# Tá»‡p SQL, log, sao lÆ°u, cáº¥u hÃ¬nh Composer
<FilesMatch "\.(sql|log|bak|ini|lock)$|^composer\.json$">
    Require all denied
</FilesMatch>

